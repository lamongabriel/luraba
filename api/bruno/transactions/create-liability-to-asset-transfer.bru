meta {
  name: create liability to asset transfer
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "type": "transfer",
    "description": "Borrow funds",
    "fromAmount": 8000,
    "fromAccountId": "{{liabilityAccountId}}",
    "toAccountId": "{{accountId}}",
    "purchaseDate": "2026-03-24",
    "postedDate": "2026-03-24"
  }
}

tests {
  test("liability to asset transfer returns 201", function() {
    expect(res.status).to.equal(201);
  });
}
