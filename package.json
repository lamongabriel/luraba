{
  "name": "luraba",
  "version": "1.2.0",
  "description": "Luraba — Finance Made Easy",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "lamongabriel",
    "url": "https://github.com/lamongabriel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lamongabriel/luraba"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.28.2"
  },
  "scripts": {
    "dev": "docker compose up -d db && pnpm --filter @luraba/api db:migrate && turbo run dev",
    "build": "turbo run build",
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "seed:mock": "docker compose up -d db && pnpm --filter @luraba/api db:migrate && pnpm --filter @luraba/api seed:mock",
    "test": "docker compose up -d db && turbo run test:unit && pnpm --filter @luraba/api test:integration",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "17.5.0",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  }
}
