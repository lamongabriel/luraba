{
  "name": "luraba-api",
  "version": "1.0.0",
  "description": "Luraba — Finance Made Easy",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:docker": "docker compose -f docker-compose.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.yml down -v",
    "build": "tsup src/app.ts --format cjs --dts --out-dir dist",
    "start": "node dist/app.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:configure": "npm run db:migrate && npm run db:seed"
  },
  "keywords": [
    "drizzle",
    "express",
    "api",
    "postgres",
    "typescript",
    "template"
  ],
  "author": {
    "name": "lamongabriel",
    "url": "https://github.com/lamongabriel"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lamongabriel/luraba"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "@types/pino": "^7.0.4",
    "drizzle-kit": "^0.31.9",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
