meta {
  name: list accounts
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/accounts
}

params:query {
  page: 1
  perPage: 20
  ~search: Checking
  sort: name
  sortDirection: asc
  ~types: depository,loan
  ~classifications: asset,liability
  ~currencyCodes: BRL,USD
  ~balanceMin: 0
  ~balanceMax: 100000
  ~hasInstitution: true
  ~createdAtFrom: 2025-01-01
  ~createdAtTo: 2025-12-31
  ~updatedAtFrom: 2025-01-01
  ~updatedAtTo: 2025-12-31
}

headers {
  Cookie: {{authCookie}}
}

tests {
  test("list accounts returns 200", function() {
    expect(res.status).to.equal(200);
  });
}
