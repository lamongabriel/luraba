meta {
  name: disconnect brandfetch
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/integrations/brandfetch
}

headers {
  Cookie: {{authCookie}}
}

tests {
  test("disconnect brandfetch returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("disconnect brandfetch returns not configured summary", function() {
    expect(res.body?.data?.provider).to.equal("brandfetch");
    expect(res.body?.data?.configured).to.equal(false);
    expect(res.body?.data?.status).to.equal("not_configured");
  });
}
