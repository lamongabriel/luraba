meta {
  name: list transactions
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/transactions
}

params:query {
  page: 1
  perPage: 20
  search: Salary
  sort: postedDate
  sortDirection: desc
  dateFrom: 2025-01-01
  dateTo: 2025-12-31
  originTypes: income
  ~purchaseDateFrom: 2025-01-01
  ~purchaseDateTo: 2025-12-31
  ~accountIds: {{accountId}}
  ~creditCardIds: {{creditCardId}}
  ~categoryIds: {{categoryId}}
  ~merchantIds: {{merchantId}}
  ~tagIds: {{tagId}}
  ~paymentMethodCodes: {{paymentMethodCode}}
  ~currencyCodes: BRL,USD
  ~amountMin: 0
  ~amountMax: 100000
  ~includeInBudget: true
  ~createdAtFrom: 2025-01-01
  ~createdAtTo: 2025-12-31
  ~updatedAtFrom: 2025-01-01
  ~updatedAtTo: 2025-12-31
}

headers {
  Cookie: {{authCookie}}
}
