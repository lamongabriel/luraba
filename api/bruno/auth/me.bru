meta {
  name: me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/auth/me
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("me returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("me returns active household name", function() {
    expect(res.body.data.household.name).to.be.a("string");
  });
}

script:post-response {
  if (res.body?.data?.household?.id) {
    bru.setEnvVar("householdId", res.body.data.household.id);
  }
}
