NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
# Invitation emails link to this public frontend origin.
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luraba_db
DB_USER=luraba
DB_PASSWORD=luraba
DB_SSL=false

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_high_entropy_secret_generated_with_openssl_rand_base64_32

# Social auth (optional)
# Leave blank to disable a provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Integrations
INTEGRATIONS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email delivery over authenticated SMTP (optional)
# Leave any required value blank to keep email delivery disabled.
# Resend: https://resend.com/docs/send-with-nodemailer-smtp
SMTP_PROVIDER=resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_NAME=Luraba
SMTP_FROM_EMAIL=
SMTP_REPLY_EMAIL=
SMTP_TLS_CIPHERS=

# Web push notifications (optional)
# Generate a key pair with: pnpm --filter @luraba/api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address or https URL that identifies you to push services.
VAPID_SUBJECT=

# SMS notifications (optional). No provider is bundled yet; leave blank to keep SMS disabled.
SMS_PROVIDER=

# Redis backs the background-job queue shared with the worker (apps/worker).
# Without it, notifications are still saved in-app and the worker's sweep delivers
# the rest, but only once it runs against the same database and Redis.
REDIS_URL=redis://localhost:6379
# Run statement imports in this API process (needs the API services). Set false on replicas that should only enqueue.
IMPORT_WORKER_ENABLED=true

# File storage (uploads and attachments).
# By default files go to the MinIO service that `pnpm dev` starts (S3-compatible, stored on
# your own disk). Set USE_MINIO=false and fill STORAGE_* to use S3, Cloudflare R2, Google Cloud
# Storage (HMAC keys, endpoint https://storage.googleapis.com) or any other S3-compatible bucket.
USE_MINIO=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=luraba
MINIO_ROOT_USER=luraba
MINIO_ROOT_PASSWORD=luraba-secret-key

STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Leave the endpoint empty for AWS S3. R2: https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=
STORAGE_KEY_PREFIX=
STORAGE_MAX_UPLOAD_MB=20

# Market data (investments). Yahoo Finance, BCB and Tesouro Transparente need no key.
# Alpha Vantage: free key at https://www.alphavantage.co/support/#api-key (about 25 requests/day
# on the free tier; set ALPHA_VANTAGE_PREMIUM=true for a paid key to lift the limit).
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_PREMIUM=
# brapi.dev token for B3 quotes (https://brapi.dev/dashboard).
BRAPI_TOKEN=
MARKET_DATA_TIMEOUT_MS=8000
