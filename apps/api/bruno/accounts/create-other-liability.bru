meta {
  name: create other liability account
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/accounts
  body: json
}

headers {
  Cookie: {{authCookie}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Tax Payable",
    "type": "other_liability",
    "currencyCode": "{{currencyCode}}",
    "openingBalance": 420000,
    "details": {
      "kind": "other_liability",
      "subtype": "tax"
    }
  }
}
