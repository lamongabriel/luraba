meta {
  name: create account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/accounts
  body: json
}

headers {
  Cookie: {{authCookie}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Primary Checking",
    "institutionName": "{{accountInstitutionName}}",
    "institutionDomain": "{{accountInstitutionDomain}}",
    "type": "cash",
    "currencyCode": "{{currencyCode}}",
    "openingBalance": 250000,
    "balanceAsOfDate": "2025-01-01",
    "details": {
      "kind": "cash",
      "subtype": "checking",
      "last4": "1234",
      "annualPercentageYield": 4.2500
    }
  }
}

tests {
  test("account returns 201", function() {
    expect(res.status).to.equal(201);
  });

  test("account returns institution fields", function() {
    expect(res.body?.data?.institutionName).to.equal(bru.getEnvVar("accountInstitutionName"));
    expect(res.body?.data?.institutionDomain).to.be.a("string");
  });

  test("account returns its typed profile", function() {
    expect(res.body?.data?.details?.kind).to.equal("cash");
    expect(res.body?.data?.details?.subtype).to.equal("checking");
  });
}

script:post-response {
  if (res.body?.data?.id) {
    const createdId = res.body.data.id;
    bru.setEnvVar("accountId", createdId);
  }
}
