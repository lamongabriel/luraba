meta {
  name: register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{origin}}
}

body:json {
  {
    "name": "{{userName}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

vars:pre-request {
  userName: Gabriel
  userEmail: lamongabriel@icloud.com
  userPassword: 123123123
  baseUrl: http://localhost:8080
  origin: http://localhost:29670
}

script:post-response {
  const cookies = res.headers?.["set-cookie"] ?? res.headers?.["Set-Cookie"];
  const firstCookie = Array.isArray(cookies) ? cookies[0] : cookies;
  
  if (firstCookie) {
    bru.setEnvVar("authCookie", firstCookie.split(";")[0]);
  }
}

tests {
  test("register returns 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("register returns the created user", function() {
    expect(res.body.user.email).to.equal(bru.getEnvVar("userEmail"));
  });
}
