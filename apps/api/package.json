{
  "name": "@luraba/api",
  "version": "1.1.0",
  "description": "Luraba - Finance Made Easy",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:mock": "tsx src/db/mock/run.ts",
    "test:integration": "DOTENV_CONFIG_PATH=.env.test NODE_ENV=test RUN_DB_TESTS=1 vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "DOTENV_CONFIG_PATH=.env.test NODE_ENV=test RUN_DB_TESTS=1 vitest --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "keywords": [
    "drizzle",
    "express",
    "api",
    "postgres",
    "typescript",
    "template"
  ],
  "author": {
    "name": "lamongabriel",
    "url": "https://github.com/lamongabriel"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lamongabriel/luraba"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "dependencies": {
    "@luraba/contracts": "workspace:*",
    "@luraba/domain": "workspace:*",
    "better-auth": "^1.6.19",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yahoo-finance2": "^3.14.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.9",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
