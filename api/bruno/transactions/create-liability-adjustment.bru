meta {
  name: create liability adjustment
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
}

headers {
  Cookie: {{authCookie}}
  Content-Type: application/json
}

body:json {
  {
    "type": "adjustment",
    "description": "Liability opening balance",
    "balance": 12000,
    "accountId": "{{liabilityAccountId}}",
    "purchaseDate": "2026-03-24",
    "postedDate": "2026-03-24"
  }
}

tests {
  test("liability adjustment returns 201", function() {
    expect(res.status).to.equal(201);
  });
}
