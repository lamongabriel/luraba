meta {
  name: create loan account
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/accounts
  body: json
}

headers {
  Cookie: {{authCookie}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Primary Loan",
    "type": "loan",
    "currencyCode": "{{currencyCode}}",
    "openingBalance": 3500000,
    "details": {
      "kind": "loan",
      "subtype": "personal",
      "originalPrincipal": 3500000,
      "annualInterestRate": 9.7500,
      "interestRateType": "fixed",
      "termMonths": 36,
      "startDate": "2025-01-01",
      "maturityDate": "2027-12-31",
      "paymentAmount": 112500,
      "paymentFrequency": "monthly"
    }
  }
}

tests {
  test("loan account returns 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setEnvVar("liabilityAccountId", res.body.data.id);
  }
}
