meta {
  name: create expense category
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Office",
    "type": "expense"
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setEnvVar("categoryId", res.body.data.id);
    bru.setEnvVar("expenseCategoryId", res.body.data.id);
  }
}

tests {
  test("category returns 201", function() {
    expect(res.status).to.equal(201);
  });
}
