# Development image — hot-reload via tsx watch
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY api/package.json ./api/package.json
RUN pnpm install --filter ./api... --frozen-lockfile --ignore-scripts

WORKDIR /app/api

COPY api/tsconfig.json ./tsconfig.json
COPY api/auth.ts ./auth.ts
# src/ is mounted as a volume at runtime for hot-reload

EXPOSE 8080

CMD ["pnpm", "run", "dev"]
