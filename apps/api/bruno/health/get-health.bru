meta {
  name: get health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
}

tests {
  test("health returns 200 or 503", function() {
    expect([200, 503]).to.include(res.status);
  });

  test("health returns overall status", function() {
    expect(res.body.status).to.be.oneOf(["ok", "degraded", "error"]);
  });

  test("health returns api/db/fx sections", function() {
    expect(res.body.services.api.status).to.equal("up");
    expect(res.body.services.db.status).to.be.oneOf(["up", "down"]);
    expect(res.body.services.fxProviders).to.be.an("object");
  });
}
