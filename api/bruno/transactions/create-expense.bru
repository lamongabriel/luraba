meta {
  name: create expense
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
}

headers {
  Cookie: {{authCookie}}
  Content-Type: application/json
}

body:json {
  {
    "type": "expense",
    "description": "Lunch",
    "amount": 2500,
    "currencyCode": "{{currencyCode}}",
    "paymentMethodCode": "{{paymentMethodCode}}",
    "accountId": "{{accountId}}",
    "categoryId": "{{expenseCategoryId}}",
    "purchaseDate": "2026-03-24",
    "postedDate": "2026-03-24"
  }
}
