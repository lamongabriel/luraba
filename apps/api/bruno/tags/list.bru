meta {
  name: list tags
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/tags
}

params:query {
  page: 1
  perPage: 20
  ~search: Travel
  sort: name
  sortDirection: asc
  ~colors: #16A34A,#2563EB
  ~icons: Ticket01Icon,Calendar03Icon
  ~hasColor: true
  ~hasIcon: true
  ~createdAtFrom: 2025-01-01
  ~createdAtTo: 2025-12-31
  ~updatedAtFrom: 2025-01-01
  ~updatedAtTo: 2025-12-31
}

headers {
  Cookie: {{authCookie}}
}

tests {
  test("list tags returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("list tags returns an array", function() {
    expect(res.body?.data).to.be.an("array");
  });
}

script:post-response {
  const first = res.body?.data?.[0];

  if (first?.id) {
    bru.setEnvVar("tagId", first.id);
  }
}
