meta {
  name: create loan account
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/accounts
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Primary Loan",
    "classification": "liability",
    "type": "loan",
    "currencyCode": "{{currencyCode}}"
  }
}

tests {
  test("loan account returns 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setEnvVar("liabilityAccountId", res.body.data.id);
  }
}
