{
  "name": "luraba",
  "version": "1.0.0",
  "description": "Luraba — Finance Made Easy",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "lamongabriel",
    "url": "https://github.com/lamongabriel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lamongabriel/luraba"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "docker compose up --build",
    "down": "docker compose down --remove-orphans -v",
    "logs": "docker compose logs --follow",
    "status": "docker compose ps --all",
    "db:migrate": "docker compose run --build --rm db-setup pnpm db:migrate",
    "db:seed": "docker compose run --build --rm db-setup pnpm db:seed",
    "db:seed:mock": "docker compose run --build --rm db-setup pnpm db:seed:mock",
    "skills:list": "DISABLE_TELEMETRY=1 pnpm exec skills list --json",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:update": "node scripts/update-skills.mjs",
    "build": "pnpm build:api && pnpm build:ui",
    "build:api": "pnpm --dir api build",
    "build:ui": "pnpm --dir ui build",
    "check": "biome check .",
    "check:api": "pnpm --dir api check",
    "check:fix": "biome check --write .",
    "check:fix:unsafe": "biome check --write --unsafe .",
    "check:ci": "biome ci .",
    "check:ui": "pnpm --dir ui check",
    "commitlint": "commitlint",
    "fix": "biome check --write .",
    "fix:api": "pnpm --dir api fix",
    "fix:ui": "pnpm --dir ui fix",
    "format": "biome format --write .",
    "format:api": "pnpm --dir api format",
    "format:check": "biome format .",
    "format:ui": "pnpm --dir ui format",
    "lint": "biome lint .",
    "lint:api": "pnpm --dir api lint",
    "lint:fix": "biome lint --write .",
    "lint:fix:unsafe": "biome lint --write --unsafe .",
    "lint:ui": "pnpm --dir ui lint",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "test": "pnpm test:api && pnpm test:ui",
    "test:api": "pnpm --dir api test",
    "test:api:unit": "pnpm --dir api test:unit",
    "test:ui": "pnpm --dir ui test",
    "typecheck": "pnpm typecheck:api && pnpm typecheck:ui",
    "typecheck:api": "pnpm --dir api typecheck",
    "typecheck:ui": "pnpm --dir ui typecheck",
    "validate": "pnpm check:ci && pnpm typecheck && pnpm test && pnpm build",
    "validate:api": "pnpm --dir api validate",
    "validate:ui": "pnpm --dir ui validate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "17.0.7",
    "skills": "1.5.22"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  }
}
