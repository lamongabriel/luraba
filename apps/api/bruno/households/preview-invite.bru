meta {
  name: preview invite
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/households/invites/preview
}

params:query {
  token: {{householdInviteToken}}
}

tests {
  test("invite preview returns recipient-safe details", function() {
    expect(res.status).to.equal(200);
    expect(res.body?.data?.email).to.equal(bru.getEnvVar("householdInviteEmail"));
    expect(res.body?.data?.household?.name).to.be.a("string");
    expect(res.body?.data).to.not.have.property("token");
    expect(res.body?.data).to.not.have.property("tokenHash");
  });
}
