meta {
  name: create income
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
  auth: none
}

headers {
  Cookie: {{authCookie}}
  Content-Type: application/json
}

body:json {
  {
    "type": "income",
    "description": "Salary",
    "amount": 150000,
    "currencyCode": "{{currencyCode}}",
    "paymentMethodCode": "{{paymentMethodCode}}",
    "categoryId": "{{incomeCategoryId}}",
    "accountId": "{{accountId}}",
    "purchaseDate": "2026-01-24",
    "postedDate": "2026-01-24"
  }
}
