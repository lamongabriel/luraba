meta {
  name: list tags
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/tags
}

headers {
  Cookie: {{authCookie}}
}

tests {
  test("list tags returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("list tags returns an array", function() {
    expect(res.body?.data).to.be.an("array");
  });
}

script:post-response {
  const first = res.body?.data?.[0];

  if (first?.id) {
    bru.setEnvVar("tagId", first.id);
  }
}
