NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luraba_db
