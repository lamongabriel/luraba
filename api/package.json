{
  "name": "luraba-api",
  "version": "1.0.0",
  "description": "Luraba — Finance Made Easy",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:docker": "docker compose -f docker-compose.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.yml down -v",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:configure": "npm run db:migrate && npm run db:seed",
    "test": "DOTENV_CONFIG_PATH=.env.test NODE_ENV=test RUN_DB_TESTS=1 vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "DOTENV_CONFIG_PATH=.env.test NODE_ENV=test RUN_DB_TESTS=1 vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "pre-commit": "lint-staged"
  },
  "keywords": [
    "drizzle",
    "express",
    "api",
    "postgres",
    "typescript",
    "template"
  ],
  "author": {
    "name": "lamongabriel",
    "url": "https://github.com/lamongabriel"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lamongabriel/luraba"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.19",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yahoo-finance2": "^3.14.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.9",
    "lint-staged": "^17.0.7",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
