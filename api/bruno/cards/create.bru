meta {
  name: create card
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/cards
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "accountId": "{{accountId}}",
    "name": "Mastercard",
    "brand": "Mastercard",
    "last4": "1234",
    "limitAmount": 300000,
    "currencyId": "{{currencyId}}",
    "closingDay": 15,
    "dueDay": 22,
    "graceDays": 0
  }
}

tests {
  test("card returns 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setEnvVar("cardId", res.body.data.id);
  }
}
