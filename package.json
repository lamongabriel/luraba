{
  "name": "luraba",
  "version": "1.3.0",
  "description": "Luraba — Finance Made Easy",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "lamongabriel",
    "url": "https://github.com/lamongabriel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lamongabriel/luraba"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.28.2"
  },
  "scripts": {
    "dev": "./scripts/dev.sh up",
    "dev:light": "./scripts/dev.sh up --light",
    "dev:stop": "./scripts/dev.sh stop",
    "dev:doctor": "./scripts/dev.sh doctor",
    "db": "./scripts/dev.sh db",
    "db:migrate": "./scripts/dev.sh migrate",
    "db:reset": "./scripts/dev.sh db-reset",
    "db:studio": "./scripts/dev.sh studio",
    "db:dump": "./scripts/dev.sh db:dump",
    "db:restore": "./scripts/dev.sh db:restore",
    "test:dev-sh": "bash scripts/tests/dev-sh.test.sh",
    "build": "turbo run build",
    "check": "biome check .",
    "fix": "biome check --write .",
    "down": "docker compose down --volumes --remove-orphans --rmi local",
    "format": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "seed:mock": "docker compose up -d --wait db && pnpm --filter @luraba/api db:migrate && pnpm --filter @luraba/api seed:mock",
    "test": "docker compose up -d --wait db && turbo run test:unit && pnpm --filter @luraba/api test:integration",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "17.0.7",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  }
}
