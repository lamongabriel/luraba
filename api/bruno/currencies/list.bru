meta {
  name: list currencies
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/currencies
}

params:query {
  page: 1
  perPage: 20
  ~search: BRL
  sort: code
  sortDirection: asc
  ~codes: BRL,USD
  ~precisions: 0,2
}

headers {
  Cookie: {{authCookie}}
}

tests {
  test("currencies returns 200", function() {
    expect(res.status).to.equal(200);
  });
}

script:post-response {
  const currencies = res.body?.data;
  if (!Array.isArray(currencies)) {
    return;
  }

  const brl = currencies.find((currency) => currency.code === "BRL");
  if (brl?.code) {
    bru.setEnvVar("currencyCode", brl.code);
    return;
  }

  if (currencies[0]?.code) {
    bru.setEnvVar("currencyCode", currencies[0].code);
  }
}
