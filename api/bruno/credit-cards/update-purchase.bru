meta {
  name: update purchase
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/v1/credit-cards/{{creditCardId}}/purchases/{{creditCardPurchaseId}}
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "description": "Updated installment purchase",
    "amount": 90000,
    "categoryId": "{{expenseCategoryId}}",
    "purchaseDate": "2026-03-24",
    "postedDate": "2026-03-29",
    "installmentCount": 3
  }
}

tests {
  test("credit card purchase update returns 200", function() {
    expect(res.status).to.equal(200);
  });
}
