meta {
  name: list members
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/households/{{householdId}}/members
}

params:query {
  page: 1
  perPage: 20
  ~search: Gabriel
  sort: name
  sortDirection: asc
  ~roles: owner,admin,member,viewer
  ~createdAtFrom: 2025-01-01
  ~createdAtTo: 2025-12-31
  ~updatedAtFrom: 2025-01-01
  ~updatedAtTo: 2025-12-31
}

headers {
  Cookie: {{authCookie}}
}

tests {
  test("members returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("members returns an array", function() {
    expect(res.body?.data).to.be.an("array");
  });
}

script:post-response {
  const first = res.body?.data?.[0];

  if (first?.userId) {
    bru.setEnvVar("householdMemberUserId", first.userId);
    bru.setEnvVar("householdMemberRole", first.role);
  }
}
