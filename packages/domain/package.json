{
  "name": "@luraba/domain",
  "version": "1.1.0",
  "private": true,
  "description": "Framework-free Luraba finance, date, and recurrency primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    },
    "./classification": {
      "types": "./dist/classification.d.ts",
      "import": "./dist/classification.js"
    },
    "./periods": {
      "types": "./dist/periods.d.ts",
      "import": "./dist/periods.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "import": "./dist/date.js"
    },
    "./recurrency": {
      "types": "./dist/recurrency.d.ts",
      "import": "./dist/recurrency.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "date-fns": "catalog:"
  }
}
