meta {
  name: list my invites
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/households/invites
}

params:query {
  page: 1
  perPage: 20
  ~search: invitee@example.com
  sort: createdAt
  sortDirection: desc
  ~householdIds: {{householdId}}
  ~roles: admin,member,viewer
  ~statuses: pending,accepted,revoked
  ~createdAtFrom: 2025-01-01
  ~createdAtTo: 2025-12-31
  ~updatedAtFrom: 2025-01-01
  ~updatedAtTo: 2025-12-31
}

headers {
  Cookie: {{authCookie}}
}

tests {
  test("my invites returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("my invites returns an array", function() {
    expect(res.body?.data).to.be.an("array");
  });
}

script:post-response {
  const first = res.body?.data?.[0];

  if (first?.id) {
    bru.setEnvVar("householdInviteId", first.id);
  }
}
