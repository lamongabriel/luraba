meta {
  name: update my preferences
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/auth/me/preferences
  body: json
}

headers {
  Cookie: {{authCookie}}
  Content-Type: application/json
}

body:json {
  {
    "language": "pt-BR",
    "preferredTheme": "dark"
  }
}

tests {
  test("preferences update returns 200", function() {
    expect(res.status).to.equal(200);
  });
}
