# Where the Luraba API listens (no /api/v1 suffix).
LURABA_API_URL=http://127.0.0.1:3001
# A personal API key (Settings > API keys, or `pnpm --filter @luraba/mcp create-dev-key`). Never commit it.
LURABA_API_KEY=lur_replace_with_your_key
# Optional: the household to act in. Without it the API uses your default household.
# LURABA_HOUSEHOLD_ID=00000000-0000-0000-0000-000000000000

# stdio (Claude Code, Claude Desktop) or http (streamable HTTP for remote hosts).
MCP_TRANSPORT=stdio
# http transport only:
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3333
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
