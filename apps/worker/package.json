{
  "name": "@luraba/worker",
  "version": "1.2.1",
  "description": "Luraba background worker: notification delivery and scheduled jobs",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "dependencies": {
    "@luraba/contracts": "workspace:*",
    "@luraba/db": "workspace:*",
    "@luraba/domain": "workspace:*",
    "@luraba/notifications": "workspace:*",
    "@luraba/queue": "workspace:*",
    "bullmq": "^6.5.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
