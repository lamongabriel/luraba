meta {
  name: login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

headers {
  Content-Type: application/json
  Origin: {{origin}}
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

tests {
  test("login returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("login returns the signed-in user", function() {
    expect(res.body.user.email).to.equal(bru.getEnvVar("userEmail"));
  });
}

script:post-response {
  const cookies = res.headers?.["set-cookie"] ?? res.headers?.["Set-Cookie"];
  const firstCookie = Array.isArray(cookies) ? cookies[0] : cookies;

  if (firstCookie) {
    bru.setEnvVar("authCookie", firstCookie.split(";")[0]);
  }
}
