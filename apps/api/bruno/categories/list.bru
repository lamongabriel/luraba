meta {
  name: list categories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/categories
  body: none
  auth: none
}

params:query {
  page: 1
  perPage: 20
  ~search: Food
  sort: name
  sortDirection: asc
  ~types: expense,income
  ~parentIds: {{categoryId}}
  ~hasParent: true
  ~colors: #10B981,#2563EB
  ~icons: AppleIcon,Wallet02Icon
  ~createdAtFrom: 2025-01-01
  ~createdAtTo: 2025-12-31
  ~updatedAtFrom: 2025-01-01
  ~updatedAtTo: 2025-12-31
}

headers {
  Cookie: {{authCookie}}
}

script:post-response {
  const categories = res.body?.data;
  if (!Array.isArray(categories)) {
    return;
  }
  
  const expense = categories.find((category) => category.type === "expense");
  if (expense?.id) {
    bru.setEnvVar("categoryId", expense.id);
    bru.setEnvVar("expenseCategoryId", expense.id);
  }
  
  const income = categories.find((category) => category.type === "income");
  if (income?.id) {
    bru.setEnvVar("incomeCategoryId", income.id);
  }
}
