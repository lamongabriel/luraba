meta {
  name: create adjustment
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "type": "adjustment",
    "description": "Initial balance adjustment",
    "amount": 5000,
    "targetType": "account",
    "targetId": "{{accountId}}",
    "direction": "increase",
    "purchaseDate": "2026-03-24",
    "postedDate": "2026-03-24"
  }
}
