# Development image — hot-reload via tsx watch
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json ./
COPY pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY tsconfig.json ./
# src/ is mounted as a volume at runtime for hot-reload

EXPOSE 8080

CMD ["pnpm", "run", "dev"]
