meta {
  name: get details
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/accounts/{{accountId}}
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("account details returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("account details includes institution logo field", function() {
    expect(res.body?.data).to.have.property("institutionLogoUrl");
  });
}
