meta {
  name: create income category
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: none
}

headers {
  Cookie: {{authCookie}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Salary",
    "type": "income"
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setEnvVar("categoryId", res.body.data.id);
    bru.setEnvVar("incomeCategoryId", res.body.data.id);
  }
}

tests {
  test("category returns 201", function() {
    expect(res.status).to.equal(201);
  });
}
