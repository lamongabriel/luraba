meta {
  name: update account
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/accounts/{{accountId}}
  body: json
}

headers {
  Cookie: {{authCookie}}
  Content-Type: application/json
}

body:json {
  {
    "institutionName": "{{accountInstitutionName}}",
    "institutionDomain": "{{accountInstitutionDomain}}",
    "notes": "Updated from Bruno",
    "details": {
      "kind": "cash",
      "subtype": "savings",
      "last4": null,
      "annualPercentageYield": 5.1000
    }
  }
}

tests {
  test("account update returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("account update returns updated fields", function() {
    expect(res.body?.data?.id).to.equal(bru.getEnvVar("accountId"));
    expect(res.body?.data?.notes).to.equal("Updated from Bruno");
  });
}
