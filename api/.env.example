# Application
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Database (individual parts — used to build DATABASE_URL in src/db/index.ts)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drizzle_express_api
DB_USER=postgres
DB_PASSWORD=postgres

# Constructed database URL (used by drizzle-kit CLI tools)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drizzle_express_api

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
