meta {
  name: list merchants
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/merchants
}

params:query {
  page: 1
  perPage: 20
  ~search: Nubank
  sort: name
  sortDirection: asc
  ~hasDomain: true
  ~hasLogo: true
  ~createdAtFrom: 2025-01-01
  ~createdAtTo: 2025-12-31
  ~updatedAtFrom: 2025-01-01
  ~updatedAtTo: 2025-12-31
}

headers {
  Cookie: {{authCookie}}
}

tests {
  test("list merchants returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("list merchants returns an array", function() {
    expect(res.body?.data).to.be.an("array");
  });
}

script:post-response {
  const first = res.body?.data?.[0];

  if (first?.id) {
    bru.setEnvVar("merchantId", first.id);
  }
}
