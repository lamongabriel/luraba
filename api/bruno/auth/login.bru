meta {
  name: login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

tests {
  test("login returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("login returns active household name", function() {
    expect(res.body.data.household.name).to.be.a("string");
  });
}

script:post-response {
  if (res.body?.data?.accessToken) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
  }

  if (res.body?.data?.household?.id) {
    bru.setEnvVar("householdId", res.body.data.household.id);
  }
}
