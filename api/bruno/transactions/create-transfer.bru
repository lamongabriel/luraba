meta {
  name: create transfer
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "type": "transfer",
    "description": "Pay down loan",
    "fromAmount": 10000,
    "fromAccountId": "{{accountId}}",
    "toAccountId": "{{liabilityAccountId}}",
    "purchaseDate": "2026-03-24",
    "postedDate": "2026-03-24"
  }
}
