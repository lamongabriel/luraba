NODE_ENV=development
LOG_LEVEL=debug
# Links in notification emails point to this public frontend origin.
FRONTEND_ORIGIN=http://localhost:3000

# Database (same database as the API)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luraba_db
DB_USER=luraba
DB_PASSWORD=luraba
DB_SSL=false

# Queue (same Redis as the API)
REDIS_URL=redis://localhost:6379
# Jobs processed at the same time.
WORKER_CONCURRENCY=5

# Email delivery over authenticated SMTP (optional). Mirror the API's values.
SMTP_PROVIDER=resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_NAME=Luraba
SMTP_FROM_EMAIL=
SMTP_REPLY_EMAIL=
SMTP_TLS_CIPHERS=

# Web push (optional). Mirror the API's values.
# Generate a key pair with: pnpm --filter @luraba/worker exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# SMS (optional). No provider is bundled yet; leave blank to keep SMS disabled.
SMS_PROVIDER=
