meta {
  name: list categories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/categories
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  const categories = res.body?.data;
  if (!Array.isArray(categories)) {
    return;
  }
  
  const expense = categories.find((category) => category.type === "expense");
  if (expense?.id) {
    bru.setEnvVar("categoryId", expense.id);
    bru.setEnvVar("expenseCategoryId", expense.id);
  }
  
  const income = categories.find((category) => category.type === "income");
  if (income?.id) {
    bru.setEnvVar("incomeCategoryId", income.id);
  }
}
