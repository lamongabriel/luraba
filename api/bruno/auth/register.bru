meta {
  name: register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{userName}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}",
    "preferences": {
      "language": "en",
      "currency": "{{currencyCode}}",
      "timezone": "America/Sao_Paulo",
      "dateFormat": "DD/MM/YYYY",
      "preferredPeriod": "current_month",
      "preferredTheme": "system"
    },
    "household": {
      "name": "{{userName}}'s Household",
      "settings": {
        "defaultCurrencyId": "{{currencyCode}}",
        "countryCode": "BR",
        "timezone": "America/Sao_Paulo",
        "budgetMonthStartsOn": 1,
        "creditExpenseTiming": "spend_month",
        "creditInstallmentBudgetMode": "per_installment"
      }
    }
  }
}

vars:pre-request {
  userName: Gabriel
  userEmail: gabriel@gabriel.com
  userPassword: 123123123
  baseUrl: http://localhost:8080
}

script:post-response {
  if (res.body?.data?.accessToken) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
  }

  if (res.body?.data?.household?.id) {
    bru.setEnvVar("householdId", res.body.data.household.id);
  }
}

tests {
  test("register returns 201", function() {
    expect(res.status).to.equal(201);
  });

  test("register returns active household name", function() {
    expect(res.body.data.household.name).to.be.a("string");
  });
}
